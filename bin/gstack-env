#!/usr/bin/env bash
# bin/gstack-env — gstack-copilot-jp 環境変数の出力
# 使い方: eval "$(bin/gstack-env)"
# 効果: $B エイリアス、bin/ を PATH に追加、ホスト検出（現在のシェルのみ）

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BROWSE_DIR="$PROJECT_ROOT/browse"

# ホスト検出（GSTACK_HOST 未設定の場合のみ）
if [ -z "${GSTACK_HOST:-}" ]; then
  if [ -n "${VSCODE_PID:-}" ] || { [ "${TERM_PROGRAM:-}" = "vscode" ] && [ -n "${TERM_PROGRAM_VERSION:-}" ]; }; then
    echo "export GSTACK_HOST=\"vscode\""
  elif command -v copilot >/dev/null 2>&1; then
    echo "export GSTACK_HOST=\"cli\""
  else
    echo "export GSTACK_HOST=\"unknown\""
  fi
fi

# コンパイル済みバイナリがあればそれを $B に設定、なければ安全なフォールバック
if [ -f "$BROWSE_DIR/dist/browse" ] && [ -x "$BROWSE_DIR/dist/browse" ]; then
  echo "export B=\"$BROWSE_DIR/dist/browse\""
elif [ -f "$SCRIPT_DIR/browse.sh" ]; then
  echo "export B=\"$SCRIPT_DIR/browse.sh\""
else
  # browse 未インストール時: エラーではなく案内メッセージを出す
  echo "export B=\"echo 'browse: not available. Install with: cd browse && bun install && bun run build'\""
fi

# bin/ を PATH 先頭に追加（未追加の場合のみ）
echo "case \":\$PATH:\" in *\":$SCRIPT_DIR:\"*) ;; *) export PATH=\"$SCRIPT_DIR:\$PATH\" ;; esac"

# 状態ディレクトリ
echo "export BROWSE_STATE_DIR=\"$PROJECT_ROOT/.gstack\""
