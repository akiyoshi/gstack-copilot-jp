#!/usr/bin/env bash
# bin/gstack-env — gstack-copilot-jp 環境変数の出力
# 使い方: eval "$(bin/gstack-env)"
# 効果: $B エイリアスと bin/ を PATH に追加（現在のシェルのみ）

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BROWSE_DIR="$PROJECT_ROOT/browse"

# コンパイル済みバイナリがあればそれを $B に設定
if [ -f "$BROWSE_DIR/dist/browse" ] && [ -x "$BROWSE_DIR/dist/browse" ]; then
  echo "export B=\"$BROWSE_DIR/dist/browse\""
else
  echo "export B=\"$SCRIPT_DIR/browse.sh\""
fi

# bin/ を PATH 先頭に追加（未追加の場合のみ）
echo "case \":\$PATH:\" in *\":$SCRIPT_DIR:\"*) ;; *) export PATH=\"$SCRIPT_DIR:\$PATH\" ;; esac"

# 状態ディレクトリ
echo "export BROWSE_STATE_DIR=\"$PROJECT_ROOT/.gstack\""
