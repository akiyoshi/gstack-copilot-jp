#!/usr/bin/env bash
# gstack-review-log — レビュー結果の JSONL 書き込み
# 本家 bin/gstack-review-log と同一インターフェース
# 使い方: gstack-review-log <skill> <branch> <verdict> <findings_count>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SLUG=$("$SCRIPT_DIR/gstack-slug" 2>/dev/null || echo "unknown")
GSTACK_DIR="${HOME}/.gstack"
PROJECT_DIR="${GSTACK_DIR}/projects/${SLUG}"
mkdir -p "$PROJECT_DIR"

SKILL="${1:?skill required}"
BRANCH="${2:?branch required}"
VERDICT="${3:?verdict required}"
FINDINGS="${4:-0}"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

echo "{\"ts\":\"${TS}\",\"skill\":\"${SKILL}\",\"branch\":\"${BRANCH}\",\"verdict\":\"${VERDICT}\",\"findings_count\":${FINDINGS}}" \
  >> "${PROJECT_DIR}/${SLUG}-reviews.jsonl"
