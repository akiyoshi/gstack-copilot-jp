#!/usr/bin/env bash
# gstack-timeline-log — スキル使用のタイムライン JSONL 書き込み
# 本家 bin/gstack-timeline-log と同一インターフェース
# 使い方: gstack-timeline-log <skill> <duration_ms> <success> [version]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SLUG=$("$SCRIPT_DIR/gstack-slug" 2>/dev/null || echo "unknown")
GSTACK_DIR="${HOME}/.gstack"
ANALYTICS_DIR="${GSTACK_DIR}/analytics"
mkdir -p "$ANALYTICS_DIR"

SKILL="${1:?skill name required}"
DURATION_MS="${2:?duration_ms required}"
SUCCESS="${3:?success (true/false) required}"
VERSION="${4:-$(cat "$(git rev-parse --show-toplevel 2>/dev/null)/VERSION" 2>/dev/null || echo "unknown")}"
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

echo "{\"ts\":\"${TS}\",\"skill\":\"${SKILL}\",\"duration_ms\":${DURATION_MS},\"success\":${SUCCESS},\"version\":\"${VERSION}\"}" \
  >> "${ANALYTICS_DIR}/skill-usage.jsonl"
