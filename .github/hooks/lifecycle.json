{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash bin/gstack-session-start.sh"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash bin/gstack-session-end.sh"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "bash bin/gstack-pre-tool-guard.sh"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash bin/gstack-post-tool-log.sh"
      }
    ]
  }
}
