{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bin/gstack-session-start.sh"
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bin/gstack-session-end.sh"
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bin/gstack-pre-tool-guard.sh"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bin/gstack-post-tool-log.sh"
      }
    ]
  }
}
