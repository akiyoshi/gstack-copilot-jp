#!/usr/bin/env bash
# .github/skills/bin/gstack-codex-probe — Codex CLI 検出 + ヘルパー関数
#
# 本家 gstack では Codex CLI を Outside Voice として使う。
# gstack-copilot-jp では Codex CLI は使えないため、このスクリプトは
# 全ヘルパー関数を「不在」として定義し、既存の degradation パスを正常に通す。
#
# 使い方: source .github/skills/bin/gstack-codex-probe

# Codex CLI の認証チェック（常に失敗 → subagent-only モードに遷移）
_gstack_codex_auth_probe() {
  return 1
}

# Codex CLI のバージョンチェック（no-op）
_gstack_codex_version_check() {
  return 0
}

# Codex イベントログ（no-op、ログファイルに書くだけ）
_gstack_codex_log_event() {
  local event="${1:-unknown}"
  local detail="${2:-}"
  local log_dir="${HOME}/.gstack/analytics"
  mkdir -p "$log_dir" 2>/dev/null
  echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event\":\"$event\",\"detail\":\"$detail\",\"host\":\"${GSTACK_HOST:-unknown}\"}" >> "$log_dir/codex-events.jsonl" 2>/dev/null || true
}

# Codex ハング検出ログ（no-op）
_gstack_codex_log_hang() {
  local skill="${1:-unknown}"
  local phase="${2:-0}"
  _gstack_codex_log_event "codex_hang" "skill=$skill,phase=$phase"
}

# Codex 利用可能チェック（常に false）
_gstack_codex_available() {
  return 1
}
