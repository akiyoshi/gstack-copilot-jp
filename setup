#!/usr/bin/env bash
# setup — gstack-copilot-jp セットアップスクリプト
# 使い方:
#   ./setup                    project-local モード（デフォルト）
#   ./setup --mode user-link   ~/.copilot/skills/ にシンボリックリンク
#   ./setup --uninstall        アンインストール

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_MANIFEST="$HOME/.gstack/hosts/copilot-cli/installations/gstack-copilot-jp.json"

MODE="project-local"
for arg in "$@"; do
  case "$arg" in
    --mode) shift; MODE="${1:-project-local}"; shift ;;
    --uninstall) MODE="uninstall" ;;
  esac
done

check_deps() {
  local missing=()
  command -v git &>/dev/null || missing+=("git")
  command -v bun &>/dev/null || missing+=("bun (https://bun.sh)")
  if [ ${#missing[@]} -gt 0 ]; then
    echo "Missing dependencies: ${missing[*]}" >&2
    exit 1
  fi
  echo "✓ Dependencies OK (git, bun)"
}

build_browse() {
  echo "Building browse..."
  cd "$SCRIPT_DIR/browse"
  bun install --frozen-lockfile 2>/dev/null || bun install
  bun run build
  echo "✓ browse binary built: browse/dist/browse"
  cd "$SCRIPT_DIR"
}

install_playwright() {
  if ! npx playwright install --dry-run chromium &>/dev/null 2>&1; then
    echo "Installing Playwright Chromium..."
    npx playwright install chromium
  fi
  echo "✓ Playwright Chromium ready"
}

write_manifest() {
  local dir
  dir="$(dirname "$INSTALL_MANIFEST")"
  mkdir -p "$dir"
  cat > "$INSTALL_MANIFEST" << EOF
{
  "path": "$SCRIPT_DIR",
  "mode": "$MODE",
  "installed": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "version": "$(cat "$SCRIPT_DIR/VERSION")"
}
EOF
  echo "✓ Manifest written: $INSTALL_MANIFEST"
}

do_project_local() {
  echo "=== gstack-copilot-jp setup (project-local) ==="
  check_deps
  build_browse
  install_playwright
  write_manifest
  echo ""
  echo "Done! Add this folder to your VS Code workspace, or run:"
  echo "  eval \"\$(bin/gstack-env)\""
}

do_user_link() {
  echo "=== gstack-copilot-jp setup (user-link) ==="
  check_deps
  build_browse

  local link_dir="$HOME/.copilot/skills/gstack-copilot-jp"
  if [ -L "$link_dir" ] || [ -d "$link_dir" ]; then
    echo "Removing existing link: $link_dir"
    rm -rf "$link_dir"
  fi
  mkdir -p "$(dirname "$link_dir")"

  # Windows + Git Bash でシンボリックリンクを作る場合 Developer Mode が必要。
  # 失敗を sentinel で先に検出し、親切なメッセージを出す。
  # (Linux/macOS/WSL2 では常に成功する)
  if [ "$(uname -o 2>/dev/null)" = "Msys" ] || [ "$(uname -o 2>/dev/null)" = "Cygwin" ]; then
    local sentinel="$HOME/.gstack-symlink-test-$$"
    if ! ln -s /tmp "$sentinel" 2>/dev/null; then
      echo "" >&2
      echo "ERROR: Windows でシンボリックリンクを作成できません。" >&2
      echo "  原因: Developer Mode が無効、または管理者権限がありません。" >&2
      echo "" >&2
      echo "  対策 (どちらか):" >&2
      echo "  1. Windows の開発者モードを有効化:" >&2
      echo "     設定 → プライバシーとセキュリティ → 開発者向け → 開発者モード ON" >&2
      echo "  2. Git Bash を「管理者として実行」で再起動して再試行" >&2
      echo "  3. 方式 A (VS Code Plugin From Source) に切替 (推奨)" >&2
      echo "     https://github.com/akiyoshi/gstack-copilot-jp の INSTALL.md 参照" >&2
      exit 1
    fi
    rm -f "$sentinel"
  fi

  ln -s "$SCRIPT_DIR" "$link_dir"
  echo "✓ Symlink: $link_dir → $SCRIPT_DIR"

  install_playwright
  sync_user_skills
  write_manifest
  echo ""
  echo "Done! Skills are available in all Copilot CLI sessions."
}

sync_user_skills() {
  # 各スキル個別の link を ~/.copilot/skills/ にも貼る。
  # repo root link だけだと VS Code Copilot Chat / Copilot CLI が
  # サブディレクトリ単位で skill を発見できないため。
  if [ -x "$SCRIPT_DIR/bin/gstack-sync-user-skills" ]; then
    echo "Syncing per-skill user-scope links..."
    "$SCRIPT_DIR/bin/gstack-sync-user-skills" --quiet || \
      echo "  (warning: sync failed — run 'bin/gstack-sync-user-skills' manually)" >&2
  fi
}

do_uninstall() {
  echo "=== gstack-copilot-jp uninstall ==="

  # 削除順序: per-skill link → repo root link の順 (重要)。
  # repo root link を先に消すと per-skill link が dangling になり、
  # `bin/gstack-sync-user-skills` の判定が混乱する可能性がある。
  # 先に個別 link を全て解除してから root link を片付ける。

  # 個別スキル link 群を削除 (junctions on Windows, symlinks elsewhere)
  local user_skills="$HOME/.copilot/skills"
  if [ -d "$user_skills" ]; then
    local removed=0
    for d in "$SCRIPT_DIR"/.github/skills/*/; do
      [ -d "$d" ] || continue
      local name
      name=$(basename "$d")
      [ "$name" = "bin" ] && continue
      local link="$user_skills/$name"
      # symlink (POSIX) を消す
      if [ -L "$link" ]; then
        rm -f "$link"
        removed=$((removed + 1))
        continue
      fi
      # Windows junction: -L で検出されないことがあるので reparse point を確認
      if [ -d "$link" ] && command -v fsutil >/dev/null 2>&1; then
        if fsutil reparsepoint query "$(cygpath -w "$link" 2>/dev/null || echo "$link")" >/dev/null 2>&1; then
          cmd //c rmdir "$(cygpath -w "$link" 2>/dev/null || echo "$link")" >/dev/null 2>&1 || rm -rf "$link"
          removed=$((removed + 1))
        fi
      fi
    done
    [ "$removed" -gt 0 ] && echo "✓ Removed $removed per-skill user-scope link(s)"
  fi

  # シンボリックリンク削除
  local link_dir="$HOME/.copilot/skills/gstack-copilot-jp"
  if [ -L "$link_dir" ]; then
    rm "$link_dir"
    echo "✓ Removed symlink: $link_dir"
  fi

  # browse サーバー停止
  local state_file="$SCRIPT_DIR/.gstack/browse.json"
  if [ -f "$state_file" ]; then
    local pid
    pid=$(grep -o '"pid":[0-9]*' "$state_file" | grep -o '[0-9]*')
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      echo "✓ Stopped browse server (PID $pid)"
    fi
    rm -f "$state_file"
  fi

  # マニフェスト削除
  if [ -f "$INSTALL_MANIFEST" ]; then
    rm "$INSTALL_MANIFEST"
    echo "✓ Removed manifest"
  fi

  echo ""
  echo "Done! To fully remove, delete the gstack-copilot-jp directory."
}

case "$MODE" in
  project-local) do_project_local ;;
  user-link) do_user_link ;;
  uninstall) do_uninstall ;;
  *) echo "Unknown mode: $MODE. Use: project-local, user-link, --uninstall" >&2; exit 1 ;;
esac
